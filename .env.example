# Copy this file to .env and fill in the values. Never commit .env.
OPENAI_API_KEY=

# RidK / Robots in de Klas credentials (group account)
RIDK_USERNAME=
RIDK_PASSWORD=
RIDK_ORGANISATION=Universiteit Leiden
# Robot realm: portal -> robot -> hamburger menu -> clipboard (e.g. rie.5e1312363dbf49eed032e123)
RIDK_REALM=

# Shared secret for the Wizard-of-Oz panel URL (any random string)
WOZ_TOKEN=change-me
