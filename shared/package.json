{
  "name": "@pipi/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Code shared by the TypeScript frontends: protocol (mirrored in Python), Pipi's face drawing, and the body runtime (brain link + speech)",
  "type": "module",
  "main": "./protocol.ts",
  "types": "./protocol.ts",
  "exports": {
    ".": "./protocol.ts",
    "./look": "./look/index.ts",
    "./body": "./body/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
